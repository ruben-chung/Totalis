# rfqbot configuration — copy to .env and edit. Never commit .env.
# Every variable is optional: the defaults below are what the code uses when a variable is unset
# or empty. The RFQ feed, the CLOB book channel, Gamma and the Kalshi market data are all public,
# so a blank .env runs every process in paper mode.
# Readers: rfqbot/config.py (POLYMARKET_*, PAPER_TRADING, RFQ/RAW/BOOK/KALSHI_*),
#          rfqbot/quoting/config.py (QUOTE_*), rfqbot/marginals/config.py (MARGINAL_*).

# --- Polymarket identity: deposit wallet (signature_type=3). signer == maker == deposit wallet address ---
# For other wallet types: 0 = EOA, 1 = Magic/email proxy, 2 = Safe (Polymarket UI with browser wallet)
POLYMARKET_SIGNATURE_TYPE=3
POLYMARKET_SIGNER_ADDRESS=
POLYMARKET_MAKER_ADDRESS=
# reserved: not read by the code yet (real submission). Private key of the signer.
POLYMARKET_PRIVATE_KEY=

# --- Polymarket L2 auth: CLOB API credentials (polymarket.com/settings?tab=api-keys) ---
# Only needed to receive confirmation/execution frames for submitted quotes; the RFQ stream itself is public.
# If any of the three is blank the listener connects unauthenticated and logs a warning (`listen --require-auth` makes that fatal).
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# --- Polymarket endpoints ---
POLYMARKET_RFQ_WS_URL=wss://combos-rfq-gateway-quoter.polymarket.com/ws/rfq
POLYMARKET_COMBOS_RFQ_API_URL=https://combos-rfq-api.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# reserved: not read by the code yet (real submission).
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137

# --- Listener (python -m rfqbot listen) ---
# Only "true" is accepted: there is no signing path, so PAPER_TRADING=false is rejected at startup.
PAPER_TRADING=true
# Starting capital for stage 3 (inventory/risk, not built); stored in the config, unused today.
INITIAL_CAPITAL_USD=50000
RFQ_DB_PATH=./data/rfq.db
# Every frame goes to gzipped hourly files here (~3 GB/day at ~190 RFQ/s). "none" disables.
RAW_LOG_DIR=./data/raw
# Which raw frames also go into the DB raw_messages table: non_request (default) | all | none
RAW_DB_TYPES=non_request
# The combo-markets catalog is ~215k markets; a full sync takes minutes. Refresh every 6h.
CATALOG_REFRESH_SEC=21600
# Trades broadcast 7-17s after the request (measured), so grace must cover that tail.
EXPIRY_GRACE_MS=20000
LOG_LEVEL=INFO

# --- Leg order-book recorder (python -m rfqbot.books) ---
BOOK_DB_PATH=./data/books.db
# Every CLOB frame goes to gzipped hourly files here. "none" disables.
BOOK_LOG_DIR=./data/books
# Subscribe to legs of RFQs seen in the last N hours; re-check the set every BOOK_REFRESH_SEC.
BOOK_UNIVERSE_HOURS=6
BOOK_REFRESH_SEC=60
BOOK_ASSETS_PER_CONN=500
# Coalesce: at most one book_top row per token per interval, only when best bid/ask price or size changes
# ("top"); "depth" also counts near-top depth changes (~3x more rows).
BOOK_MIN_INTERVAL_MS=1000
BOOK_CHANGE_KEY=top
# Raw-log price_change frames too? ~30 GB/day gz at current flow; false keeps snapshots/trades/ticks only.
BOOK_RAW_DELTAS=false
# Whole-game ladders: for these sports subscribe to every market of a game that an RFQ leg touches
# (others stay leg-level). Cap on game tokens (games ranked by RFQ count) and skip games starting later than N h.
BOOK_GAME_SPORTS=nfl,nba
BOOK_GAME_MAX_TOKENS=20000
BOOK_GAME_LOOKAHEAD_HOURS=72

# --- Kalshi API. Market list and order books are public (no auth). Keys (RSA private key file + key id)
# are only needed for the authenticated websocket and higher REST rate tiers. Never copy the key into this repo.
KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# reserved: not read by the code yet (demo environment).
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=

# --- Kalshi price feed (python -m rfqbot.kalshi_books). Order books and the batch market endpoint are public;
# with keys the sweep runs faster and the ticker websocket is used. Books db is separate from rfq.db / books.db.
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2
# Also read directly (os.environ) by the kalshi_books library reader that rfqbot.marginals --kalshi auto uses.
KALSHI_BOOKS_DB_PATH=./data/kalshi_books.db
# Every REST response / websocket frame goes to gzipped hourly files here. "none" disables.
KALSHI_LOG_DIR=./data/kalshi
# Batch top-of-book sweep over every open game-level market (about 8k tickers, 200 per request);
# the slower period applies when no key is configured.
KALSHI_SWEEP_SEC=15
KALSHI_SWEEP_SEC_UNAUTH=60
# /orderbook?depth=5 polls for matched tickers whose legs appeared in RFQ flow in the last BOOK_UNIVERSE_HOURS.
KALSHI_DEPTH_SEC=30
# leg_matches rebuild timer (also rebuilt whenever kalshi-sync writes new rows).
KALSHI_MATCH_REFRESH_SEC=600
# Use the ticker websocket when keys are present (false: REST sweep only).
KALSHI_WS=true

# --- Quote assembly (python -m rfqbot listen --quote; rfqbot/quoting/config.py). Probabilities are
# fractions (0.01 = one probability point). All values are first-cut placeholders for the backtest to calibrate.
# Margin m = QUOTE_K_M * u_m + QUOTE_K_D * u_d + QUOTE_BASE_EDGE + QUOTE_INVENTORY_SKEW; price = p_fair +/- m.
QUOTE_BASE_EDGE=0.005
# Multipliers on the marginal uncertainty u_m and the dependence-interval uncertainty u_d.
QUOTE_K_M=1.0
QUOTE_K_D=1.0
# Inventory term e_i (stage 3 slot; nothing writes it yet).
QUOTE_INVENTORY_SKEW=0.0
# Size per quote in USD at our price; below the minimum the RFQ is skipped.
QUOTE_MAX_SIZE_USD=500
QUOTE_MIN_SIZE_USD=5
# Price rounding (away from fair) and hard price bounds; BUY quotes above the safety max are rejected by the venue.
QUOTE_TICK=0.001
QUOTE_PRICE_MIN=0.001
QUOTE_PRICE_MAX=0.999
QUOTE_BUY_SAFETY_MAX=0.90909
# Size multipliers by worst marginal tier and by leg count (keys not listed keep the default; >4 legs use the last).
QUOTE_TIER_SIZE_MULT=ok=1.0,thin=0.5,wide=0.5,stale=0.25,disagree=0.1,skip=0.0
QUOTE_LEGS_SIZE_MULT=1=1.0,2=1.0,3=0.5,4=0.25
# Game cache: refresh period (s), rebuild the joint model when any informative mid moved this much, max games cached.
QUOTE_REFRESH_SEC=20
QUOTE_MODEL_REBUILD_MOVE=0.005
QUOTE_MAX_GAMES=400
# Every RFQ decision (quoted or skipped, with all terms) goes here; `listen --decisions-db` overrides.
QUOTE_DECISIONS_DB=./data/decisions.db
# Sports we quote (the ones the book recorder keeps ladders for); other legs skip with leg:sport_not_quoted.
QUOTE_SPORTS=nfl,nba

# --- Marginal layer (rfqbot/marginals/config.py; docs/marginal-layer-notes.md). Probabilities are fractions,
# depth and sizes are shares/contracts, time is seconds. Placeholders for the backtest to calibrate.
# sigma_v = half_spread * (1 + C_THIN / (1 + depth / D0)) + c_stale * staleness; precision = 1 / sigma^2.
MARGINAL_C_THIN=1.0
MARGINAL_D0=500
# Staleness cost per second of age: pregame ~1 pt per hour, in play ~1 pt per 10 s.
MARGINAL_C_STALE_PREGAME=0.000003
MARGINAL_C_STALE_INPLAY=0.001
# Staleness gates: warn -> flag stale:<venue>; drop -> that venue's weight is 0.
MARGINAL_STALE_WARN_PREGAME_S=600
MARGINAL_STALE_DROP_PREGAME_S=3600
MARGINAL_STALE_WARN_INPLAY_S=15
MARGINAL_STALE_DROP_INPLAY_S=60
# In play, the tier is at least `stale` unless the newest quote is younger than this.
MARGINAL_INPLAY_FRESH_S=15
# wide:<venue> when spread > K_WIDE * p(1-p) + WIDE_FLOOR; thin:<venue> when depth < D_MIN.
MARGINAL_K_WIDE=0.2
MARGINAL_WIDE_FLOOR=0.02
MARGINAL_D_MIN=50
# Kalshi precision multiplier per sport (comma list sport=value; sports not listed use the default) and the
# multiplier applied when the match is rules_differ (shifted_line / none never combine).
MARGINAL_KALSHI_PRIOR=nfl=2,nba=2
MARGINAL_KALSHI_PRIOR_DEFAULT=1.0
MARGINAL_RULES_DIFFER_SCALE=0.25
# Combined error: floor, higher floor when p is outside [DEGENERATE_LO, DEGENERATE_HI], cap (beyond it: no information).
MARGINAL_ERR_FLOOR=0.005
MARGINAL_DEGENERATE_LO=0.015
MARGINAL_DEGENERATE_HI=0.985
MARGINAL_DEGENERATE_ERR_FLOOR=0.02
# Sigma for a lone one-sided venue quote (only one side of the book is known).
MARGINAL_ONE_SIDED_SIGMA=0.15
MARGINAL_ERR_CAP=0.5
# |p_poly - p_kalshi| beyond this -> disagree_hard, tier skip.
MARGINAL_GAP_SKIP=0.10
# A venue's wide/thin/stale flags set the tier only if its weight is at least this.
MARGINAL_TIER_W_MIN=0.05

# ---- Margin optimiser (rfqbot/edge; docs/margin-optimizer-brief.md). All optional. ----
# python -m rfqbot.edge {fit|report|wallets|monitor}; output rfqbot/edge/margin_table.json, state data/edge.db
EDGE_DB=./data/edge.db
EDGE_WALLET_LIST=./data/edge_wallets.json
EDGE_N_MIN=30                 # decisions a segment needs before it stops pooling to its parent
EDGE_SIGMA_CUTS=0.005,0.009   # sigma = u_m + u_d buckets
EDGE_HORIZONS_MIN=1,5,15,30   # markout horizons
EDGE_BLOCK_MIN_FILLS=8        # wallet block rule: fills needed
EDGE_BLOCK_DAYS=7             # block expiry
EDGE_BLOCK_CONF=0.90          # one-sided bound; ~22% false positives on neutral wallets by design (missing a sharp wallet costs more)
EDGE_WALLET_K=1.0             # per-wallet premium = K * max(0, -expected profit per fill)
EDGE_MIN_FILL_RATE=0          # optimiser constraint F(m*) >= this (0 = unconstrained)
EDGE_MIN_FILL_BASIS=print     # print: F among RFQs that traded | request: F per request (~0.5%)
EDGE_CURSE_SOURCE=model       # model | measured
EDGE_REFRESH_SEC=300          # monitor period
